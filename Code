#include <Servo.h>

Servo myServo;

// HC-SR04 pins
const int trigPin = 6;
const int echoPin = 9;

// LED and servo pins
const int ledPin = 2;
const int servoPin = 3;

// Settings
const float detectionDistance = 10.0; // cm
const int normalAngle = 0;
const int detectedAngle = 90;

void setup() {
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);
  pinMode(ledPin, OUTPUT);

  myServo.attach(servoPin);
  myServo.write(normalAngle);

  digitalWrite(ledPin, LOW);

  Serial.begin(9600);
}

void loop() {
  // Send ultrasonic pulse
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);

  digitalWrite(trigPin, LOW);

  // Read echo time
  long duration = pulseIn(echoPin, HIGH, 30000);

  // Convert time to distance
  float distance = duration * 0.0343 / 2.0;

  Serial.print("Distance: ");
  Serial.print(distance);
  Serial.println(" cm");

  // Object detected at 10 cm or closer
  if (distance > 0 && distance <= detectionDistance) {
    digitalWrite(ledPin, HIGH);
    myServo.write(detectedAngle);
  } else {
    digitalWrite(ledPin, LOW);
    myServo.write(normalAngle);
  }

  delay(100);
}
